   "question_id": 90002,
   "type": "input",
   "text": "A steel tube (E = 210 GPa), 600 mm long with a 400 mm² cross-section, is loaded in tension with 45 kN. By how many millimetres does it lengthen? Give two decimals.",
   "time": 240,
   "answers": [
    {
     "answer_id": 5,
     "text": "0.32",
     "is_correct": true
