# Copy to /srv/quiz/<env>/.env on the server and `chmod 600` it. Never commit a filled-in copy.
# Generate every secret with: openssl rand -hex 24

QUIZ_ENV=staging                                  # staging | prod
QUIZ_HOST=quiz-staging.iscracingteam.com          # quiz.iscracingteam.com for prod
PROXY_NETWORK=proxy                               # Docker network shared with the website's Nginx container (isc-web)
# The proxy network's subnet: uvicorn trusts X-Forwarded-For only from it. A subnet, not the Nginx container's
# address, because the website's deploys recreate that container (runbook 1.3, ADR 0008). Only isc-web and the
# quiz api containers join this network.
FORWARDED_ALLOW_IPS=10.213.0.0/24

POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
BACKUP_PASSWORD=

# Optional: a Healthchecks.io ping URL; the nightly backup pings it after each successful dump.
BACKUP_HEARTBEAT_URL=
