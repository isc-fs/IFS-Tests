# Copy to /srv/quiz/<env>/.env on the server and `chmod 600` it. Never commit a filled-in copy.
# Generate every secret with: openssl rand -hex 24

QUIZ_ENV=staging                                  # staging | prod
QUIZ_HOST=quiz-staging.iscracingteam.com          # quiz.iscracingteam.com for prod
EDGE_NETWORK=quiz-edge                            # Docker network of the website's Nginx container (isc-web) and the quiz apis only
# The edge network's subnet: uvicorn trusts X-Forwarded-For only from it. A subnet, not isc-web's address, because
# the website's deploys and reboots change that address; nothing but isc-web and the quiz apis joins this network
# (runbook 1.3, ADR 0011).
FORWARDED_ALLOW_IPS=10.214.0.0/24

POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
BACKUP_PASSWORD=

# Optional: a Healthchecks.io ping URL; the nightly backup pings it after each successful dump.
BACKUP_HEARTBEAT_URL=

# Season 1b (ADR 0010): the one switch. The Madrid day the fair-play rules and every mechanism of release v2.0.0
# (the per-player daily, the signals, the rest) start together; unset = not yet. Set it only once the About page
# names what is collected, and change it only at a Madrid midnight (runbook, "Season 1b switch").
#IFS_RULES_1B_FROM=2026-10-26
# AI canary (ADR 0010): off until the recall pilot. Staging only, for now.
#IFS_CANARY=false
